{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "VITE_API_URL=/api npm run build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://multiagent-graphrag-api.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
