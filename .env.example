# The baseline runs fully offline and needs no API key.
GOVERNED_RAG_CORPUS=data/documents/financial_corpus.json
GOVERNED_RAG_TOP_K=3
# Optional local neural embedding backend: tfidf or ollama
GOVERNED_RAG_EMBEDDING_BACKEND=tfidf
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:latest
GOVERNED_RAG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://youseihuayu-wonderful.github.io
# Per-client guardrail for the public single-instance demo API.
GOVERNED_RAG_RATE_LIMIT_PER_MINUTE=20
GOVERNED_RAG_LOG_LEVEL=INFO
# Optional comma-separated bearer keys. Leave empty only for a public demo.
GOVERNED_RAG_API_KEYS=

# Optional real LLM agents. Keep unset for deterministic-only operation.
# Compatible with OpenAI and providers exposing the OpenAI chat-completions API.
GOVERNED_RAG_LLM_PROVIDER=openai-compatible
GOVERNED_RAG_LLM_BASE_URL=https://api.openai.com/v1
GOVERNED_RAG_LLM_MODEL=gpt-4.1-mini
GOVERNED_RAG_LLM_API_KEY=
GOVERNED_RAG_LLM_TIMEOUT_SECONDS=30

# Local Ollama preset:
# GOVERNED_RAG_LLM_PROVIDER=ollama
# GOVERNED_RAG_LLM_BASE_URL=http://127.0.0.1:11434
# GOVERNED_RAG_LLM_MODEL=qwen2.5:7b
# GOVERNED_RAG_LLM_API_KEY=ollama-local
# GOVERNED_RAG_LLM_TIMEOUT_SECONDS=120

# Ollama Cloud preset (create the key at https://ollama.com/settings/keys):
# GOVERNED_RAG_LLM_PROVIDER=ollama-cloud
# GOVERNED_RAG_LLM_BASE_URL=https://ollama.com
# GOVERNED_RAG_LLM_MODEL=gpt-oss:20b
# GOVERNED_RAG_LLM_API_KEY=<OLLAMA_API_KEY>
# GOVERNED_RAG_LLM_TIMEOUT_SECONDS=120
